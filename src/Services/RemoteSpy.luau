-- Services/RemoteSpy.luau
-- GameAnalyzer v6.0 IDE Edition — Real-time Metamethod Remote Interceptor & Generator

local Env    = require(script.Parent.Parent.Core.Env)
local Config = require(script.Parent.Parent.Core.Config)

local RemoteSpy = {}

RemoteSpy.Enabled = false
RemoteSpy.Logs = {}
RemoteSpy.MaxLogs = 300
RemoteSpy.OnLogAdded = nil -- Callback event

local rawNamecall = nil
local rawIndex = nil

function RemoteSpy.logCall(remoteInstance, method, args)
    local callerScript = "Unknown Script"
    pcall(function()
        if getfenv then
            local f = getfenv(3)
            if f and f.script then
                callerScript = f.script:GetFullName()
            end
        end
    end)

    local logEntry = {
        Id           = #RemoteSpy.Logs + 1,
        Time         = os.date("%H:%M:%S"),
        Timestamp    = os.clock(),
        Remote       = remoteInstance,
        RemoteName   = remoteInstance.Name,
        RemotePath   = remoteInstance:GetFullName(),
        ClassName    = remoteInstance.ClassName,
        Method       = method,
        Args         = args,
        SerializedArgs = Env.serialize(args),
        Caller       = callerScript,
    }

    table.insert(RemoteSpy.Logs, 1, logEntry)

    if #RemoteSpy.Logs > RemoteSpy.MaxLogs then
        table.remove(RemoteSpy.Logs)
    end

    if RemoteSpy.OnLogAdded then
        task.spawn(RemoteSpy.OnLogAdded, logEntry)
    end
end

function RemoteSpy.generateSnippet(logEntry)
    local path = logEntry.RemotePath
    local argsFormatted = {}
    for idx, arg in ipairs(logEntry.Args) do
        table.insert(argsFormatted, Env.serialize(arg))
    end
    local argStr = table.concat(argsFormatted, ", ")

    if logEntry.ClassName == "RemoteEvent" or logEntry.ClassName == "UnreliableRemoteEvent" then
        return string.format([[
-- RemoteEvent Snippet (Generated by GameAnalyzer v6.0)
local Remote = %s
Remote:FireServer(%s)
]], path, argStr)
    elseif logEntry.ClassName == "RemoteFunction" then
        return string.format([[
-- RemoteFunction Snippet (Generated by GameAnalyzer v6.0)
local Remote = %s
local response = Remote:InvokeServer(%s)
print("[Response]:", response)
]], path, argStr)
    end

    return "-- Snippet unavailable"
end

function RemoteSpy.start()
    if RemoteSpy.Enabled then return end
    if not Env.CAPS.hookmetamethod or not Env.CAPS.getnamecallmethod then
        warn("[RemoteSpy] ⚠ hookmetamethod or getnamecallmethod is missing on this executor!")
        return false, "Missing hookmetamethod capability"
    end

    RemoteSpy.Enabled = true

    local grm = Env.CAPS.getrawmetatable and getrawmetatable(game)
    if not grm then return false, "No raw metatable" end

    local setro = Env.CAPS.setreadonly or setreadonly
    if setro then setro(grm, false) end

    rawNamecall = grm.__namecall

    grm.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}

        if RemoteSpy.Enabled and typeof(self) == "Instance" then
            if (method == "FireServer" or method == "fireServer") and (self:IsA("RemoteEvent") or self:IsA("UnreliableRemoteEvent")) then
                RemoteSpy.logCall(self, "FireServer", args)
            elseif (method == "InvokeServer" or method == "invokeServer") and self:IsA("RemoteFunction") then
                RemoteSpy.logCall(self, "InvokeServer", args)
            end
        end

        return rawNamecall(self, ...)
    end)

    if setro then setro(grm, true) end
    return true
end

function RemoteSpy.stop()
    if not RemoteSpy.Enabled then return end
    RemoteSpy.Enabled = false

    local grm = Env.CAPS.getrawmetatable and getrawmetatable(game)
    if grm and rawNamecall then
        local setro = Env.CAPS.setreadonly or setreadonly
        if setro then setro(grm, false) end
        grm.__namecall = rawNamecall
        if setro then setro(grm, true) end
    end
end

function RemoteSpy.clear()
    RemoteSpy.Logs = {}
end

return RemoteSpy
